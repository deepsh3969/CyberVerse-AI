# CyberVerse AI environment configuration
# Copy to `.env` (backend) or `.env.local` (frontend) and adjust. Never commit real secrets.

# ---------------------------------------------------------------- backend
# Port the FastAPI service listens on
PORT=8000

# development | production (production enables fail-fast config validation,
# JSON logs and HSTS)
ENVIRONMENT=development

# Allowed browser origins (comma separated). Must be explicit origins in
# production; same-origin deployments (Vercel) never need CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------ persistence
# Empty = in-memory DEMO MODE (state resets on restart).
# Postgres:  postgresql+psycopg://user:pass@localhost:5432/cyberverse
# SQLite:    sqlite:///./cyberverse.db
DATABASE_URL=
# Create tables at startup (Alembic is used for real migrations; see docs/production.md)
DB_AUTOCREATE=true
DB_POOL_SIZE=10
# How many persisted events to hydrate into memory at startup
DB_EVENTS_LOADED=2000
MAX_EVENTS_RETAINED=5000

# ------------------------------------------------------------------ auth
# Authentication requires a database: it activates only when AUTH_ENABLED=true
# AND DATABASE_URL is set (see settings.auth_active).
AUTH_ENABLED=true
# Gate reads (dashboards/events) behind a token too; writes always require
# analyst/admin when auth is active.
AUTH_REQUIRE_READ=false
# HMAC secret for access tokens. REQUIRED in production, min 32 chars.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
# Initial administrator created at startup when the account does not exist.
SEED_ADMIN_EMAIL=admin@cyberverse.local
SEED_ADMIN_PASSWORD=
BCRYPT_ROUNDS=12
AUTH_LOGIN_LIMIT_PER_MINUTE=10
# Refresh cookie Secure flag (auto true in production; set false only for http dev)
COOKIES_SECURE=

# -------------------------------------------------------- observability
LOG_LEVEL=INFO
# json | text (production defaults to json)
LOG_FORMAT=
METRICS_ENABLED=true
# Reject request bodies larger than this (413)
MAX_BODY_BYTES=1048576
# Trust X-Forwarded-For for rate-limit identity (true behind a proxy/load balancer)
TRUST_PROXY=true

# -------------------------------------------------------------- ai analyst
# Optional external LLM for the AI Analyst.
# Leave AI_API_KEY empty to use the built-in local analysis engine (default).
AI_PROVIDER=local
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ------------------------------------------------------------ abuse limits
RATE_LIMIT_PER_MINUTE=240

# ---------------------------------------------------------------- frontend
# Backend base URL for production builds. Leave empty in development
# (the Vite dev server proxies /api to http://127.0.0.1:8000).
VITE_API_URL=

# Polling cadence in milliseconds
VITE_POLL_INTERVAL=3000

# ------------------------------------------------- docker compose overrides
# Read by docker-compose.yml only (see docs/production.md).
POSTGRES_USER=cyberverse
POSTGRES_PASSWORD=
POSTGRES_DB=cyberverse
API_PORT=8000
WEB_PORT=8080
# Host ports + credentials for `docker compose up` dev defaults are built in;
# set these (and ENVIRONMENT=production + JWT_SECRET + SEED_ADMIN_PASSWORD)
# before exposing the stack anywhere real.
