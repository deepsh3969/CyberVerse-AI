# CyberVerse AI frontend environment variables
# Copy this file to `.env.local` and adjust values for your machine.
# Never commit real secrets.

# Backend API base URL. Leave empty to use the dev-server proxy (/api -> http://127.0.0.1:8000)
# For production builds set the deployed backend, e.g. https://cyberverse-api.onrender.com
VITE_API_URL=

# Refresh cadence (milliseconds) for dashboard / event polling
VITE_POLL_INTERVAL=3000
